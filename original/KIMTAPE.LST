Page 7     KIMTAPE.SCR

Scr# 18 
  0 \ Default files -
  1 create   INFILE   65 allot          \ filename buffer
  2 variable INFID    infid off         \ file ID  0=closed
  3 0 value  INBUF                      \ buffer
  4 variable INPTR    variable INSIZ    \ pointer, chars in buffer
  5 
  6 create   OUTFILE  65 allot
  7 variable OUTFID   outfid off
  8 0 value  OUTBUF
  9 variable OUTPTR   variable OUTSIZ
 10 
 11 variable WRTCHK   wrtchk on         \ file overwrite check
 12 
 13 : RESETINBUF  ( -- )  inbuf inptr !  insiz off ;
 14 : RESETOUTBUF  ( -- )  outbuf outptr !  outsiz off ;
 15 

Scr# 19 
  0 \ Default files - CLOSEINFILE CLOSEOUTFILE CLOSEFILES
  1 defer (FLUSHWRITE)  ' 0    is (flushwrite)
  2 
  3 \ Close input file - errors not reported
  4 : CLOSEINFILE  ( -- )  infid @ ?dup
  5   if  close-file drop  then  infid off ;
  6 
  7 \ Close output file - errors not reported
  8 : CLOSEOUTFILE  ( -- )  outfid @ ?dup
  9   if  (flushwrite) drop  close-file drop  then  outfid off ;
 10 
 11 \ Close all files - errors not reported
 12 : CLOSEFILES  ( -- )  closeinfile  closeoutfile ;
 13 
 14 ' closefiles +defer errfix  \ close files on error
 15 

Scr# 20 
  0 \ Default files - DELOUTFILE REPOSIN/OUTFILE IN/OUTFILEPOS
  1 \ Close and delete output file - errors not reported
  2 : DELOUTFILE  ( -- )  outfid @  closeoutfile
  3   if  outfile count delete-file drop  then ;
  4 
  5 \ Reposition input file to position d
  6 : REPOSINFILE  ( ud -- )  infid @ reposf resetinbuf ;
  7 
  8 \ Reposition output file to position d
  9 : REPOSOUTFILE  ( ud -- )  (flushwrite) drop  outfid @ reposf ;
 10 
 11 \ Input file position
 12 : INFILEPOS  ( -- ud )  infid @ fpos  insiz @  0 d- ;
 13 
 14 \ Output file position
 15 : OUTFILEPOS  ( -- ud )  outfid @ fpos  outsiz @  0 d+ ;

Page 8     KIMTAPE.SCR

Scr# 21 
  0 \ Default files - OPENINFILE
  1 \ Open an input file using file access mode fam
  2 : OPENINFILE  ( fam -- )
  3   infile count  2dup upper  cr ." infile:  "  2dup type
  4   infid off  rot open-file  ?dup if  255 and
  5     case
  6       2  of  ."  file not found"  endof
  7       3  of  ."  path not found"  endof
  8       4  of  ."  too many open files"  endof
  9       5  of  ."  access denied"  endof
 10       ."  open error"
 11     endcase  error2
 12   then  infid !  resetinbuf ;
 13 
 14 
 15 

Scr# 22 
  0 \ Default files - OPENOUTFILE
  1 \ Create an output file using file access mode fam
  2 : OPENOUTFILE  ( fam -- )
  3   outfile count  2dup upper  cr ." outfile: "  2dup type
  4   outfid off  wrtchk @ if
  5     2dup r/o open-file  0= if
  6       close-file
  7       beep ."  exists - overwrite? "  y/n 0= if error2 then
  8     then  drop
  9   then
 10   rot create-file if  ."  create error"  error2  then
 11   outfid !  resetoutbuf ;
 12 
 13 
 14 
 15 

Scr# 23 
  0 \ Default files - READDATA WRITEDATA READTEXT WRITETEXT
  1 \ Read binary from input file
  2 : READDATA  ( a u1 -- a u2 )  infid @ readf ;
  3 
  4 \ Write binary to output file
  5 : WRITEDATA  ( a u -- )  outfid @ writef ;
  6 
  7 \ Read text from input file  flag=0 if end-of-file
  8 : READTEXT  ( a u1 -- a u2 flag )  infid @ readl ;
  9 
 10 \ Write text to output file
 11 : WRITETEXT  ( a u -- )  outfid @ writel ;
 12 
