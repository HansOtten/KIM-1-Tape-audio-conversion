Scr# 61 
  0 \ SAMPLE SEEK+ SEEK- SEEKHALF
  1 \ Get sample
  2 : SAMPLE  ( -- char )
  3   readchar 0= 1 ?throw  1 samplecount +! ;
  4 
  5 \ Seek +ve going edge
  6 : SEEK+  ( -- )  begin  sample  silencemax >  until ;
  7 
  8 \ Seek -ve going edge
  9 : SEEK-  ( -- )  begin  sample  silencemin <  until ;
 10 
 11 \ Seek half cycle
 12 : SEEKHALF  ( -- samples )
 13   samplecount off
 14   polarity @ if  seek+  else  seek-  then  samplecount @
 15   flip-polarity ;

Scr# 62 
  0 \ SEEKWHOLE GETTONE GETTONE-KIM GETTONE-SYM
  1 \ Seek whole cycle
  2 : SEEKWHOLE  ( -- samples )
  3   seekhalf seekhalf + ;
  4 
  5 \ Get basic element  true = high tone
  6 defer GETTONE  ( -- flag )
  7 
  8 \ For KIM get whole cycle  true = high tone
  9 : GETTONE-KIM  ( -- flag )
 10   seekwhole  maxwave > not ;
 11 
 12 \ For SYM get half cycle  true = high tone
 13 : GETTONE-SYM  ( -- flag )
 14   seekhalf  3 - maxwave > not ;
 15 

Page 22    KIMTAPE.SCR

Scr# 63 
  0 \ GETBIT-KIM
  1 \ Get next bit
  2 : GETBIT-KIM  ( -- bit )
  3   0 begin
  4     lastcycle @  dup >r  +  ( sum weights )
  5     3  ( new weight )
  6     gettone if  ( high tone )
  7       negate
  8       seekhalf drop  ( discard next half cycle )
  9     then
 10     dup lastcycle !
 11     r> <  ( compare last with new )
 12   until   ( start of new bit )
 13   0> abs ;
 14 
 15 

Scr# 64 
  0 \ GETBIT-SYM
  1 \ Get next bit
  2 : GETBIT-SYM  ( -- bit )
  3   0
  4   gettone if  ( high tone )
  5     1+
  6     seekhalf drop  ( discard next halfcycle )
  7   then ;
  8 
  9 
 10 
 11 
 12 
