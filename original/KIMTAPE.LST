Scr# 33 
  0 \ Variables -
  1 variable SADDR              \ start address
  2 variable EADDR              \ end address +1
  3 variable BITCOUNT           \ bit counter
  4 variable CHECKSUM           \ checksum
  5 variable CONOUT             \ console flag
  6 variable DECODING           \ 0=encode nz=decode
  7 variable FILEID             \ file ID
  8 variable POLARITY           \ wave polarity  0=normal nz=invert
  9 variable LASTCYCLE          \ last cycle weight
 10 variable LEADTIME           \ leader (secs)
 11 variable SAMPLECOUNT        \ sample count
 12 variable SPEED              \ speed
 13 variable MODE               \ mode flag  0=KIM nz=SYM
 14 variable SINE               \ tone type
 15 variable WAVE               \ wave type

Scr# 34 
  0 \ Variables -
  1 2variable DECODECOUNT       \ bytes decoded
  2 2variable WAVESIZ           \ wavefile data size
  3 
  4 4  constant EOT             \ Ascii end of text character
  5 22 constant SYNC            \ Ascii sync character
  6 
  7 0   value BIAS              \ waveform DC offset adjust
  8 8   value DATABITS          \ character length
  9 3   value HYSTERESIS        \ hysteresis level
 10 7   value MAXWAVE           \ max sample for high tone
 11 130 value SILENCEMAX        \ upper hysteresis level
 12 124 value SILENCEMIN        \ lower hysteresis level
