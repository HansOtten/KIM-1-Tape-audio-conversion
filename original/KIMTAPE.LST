  2 : SETENDADDR  ( -- )
  3   infid @ fsize  ( get input file size )
  4   saddr @ 0 d+   ( add startaddr )
  5   2dup $10001. du< not  if ( too high )
  6     cr ." End address exceeds $FFFF"  error2
  7   then
  8   drop  eaddr ! ;
