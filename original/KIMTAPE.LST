  0 \ Help screen - HELP
  1 : HELP  ( -- )
  2   cr ." Use:  KIMTAPE [options] infile[.typ] [outfile[.typ]]" cr
  3   cr ." -C    console output              -M    make wavefile"
  4   cr ." -Bn   HYPERTAPE speed  2x 3x 6x   -I    invert wavefile"
  5   cr ." -U    SYM-1 high speed format     -V    VOC wavefile"
  6   cr ." -Fn   offset  -127 to 127         -R    RAW wavefile"
  7   cr ." -Hn   hysteresis  0 to 127        -Ln   leader (sec)"
  8   cr ." -Gn   timing  -2 to 2             -T    sine tone"
  9   cr ." -An   load address (hex)          -Dn   prog ID (hex)"
 10   cr
