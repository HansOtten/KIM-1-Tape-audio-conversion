Scr# 4 
  0 \ Error handler - +DEFER ?THROW ?CATCH
  1 system
  2 \ Append a new behaviour to an existing deferred word
  3 : +DEFER  ( xt <name> -- )  >r  :noname  r> compile,
  4   ' >body dup @ compile,  >r  postpone ;  r> ! ;
  5 application
  6 
  7 \ THROW exception code n if flag is non-zero
  8 : ?THROW  ( flag n -- )  swap 0<> and throw ;
  9 
 10 \ Perform CATCH intercepting exception code n only
 11 : ?CATCH  ( xt n -- n )  >r catch dup r> <> over and throw ;
 12 
 13 
 14 
 15 

Scr# 5 
  0 \ Error handler - ERROR1 ERROR2 ESC= ESCKEY? (?BREAK)
  1 \ Quit to DOS with no msg and return code = 1
  2 : ERROR1  ( -- )  abort ;
  3 
  4 \ Quit with abort msg
  5 : ERROR2  ( -- )  ."  ... aborting"  error1 ;
  6 
  7 \ Test char for ESC or Ctrl-C
  8 : ESC=  ( char -- flag )  dup 27 =  swap 3 =  or ;
  9 
 10 \ Check if ESC or Ctrl-C key was pressed
 11 : ESCKEY?  ( -- flag )  0  key? if  key esc=  or  then ;
 12 
 13 \ Check user break
 14 : (?BREAK)  ( -- )  esckey? if  beep cr
 15   ." User break - exit program? " y/n if  error2  then  then ;

Page 3     KIMTAPE.SCR

Scr# 6 
  0 \ Number output -
  1 : (UD.) ( ud -- addr u )  <# #s #> ;
  2 : (U.)  ( u  -- addr u )  0 (d.) ;
  3 : (.)   ( n  -- addr u )  s>d (d.) ;
  4 : UD.   ( ud -- )  (ud.) type space ;
  5 : UD.R  ( ud n -- )  >r (ud.) r> over - spaces type ;
  6 
  7 : (DH.) ( ud -- addr u )
  8   base @ >r hex <# 8 0 do # loop #> r> base ! ;
  9 : (H.)  ( u -- addr u )  0 (dh.) 4 /string ;
 10 : (HB.) ( u -- addr u )  (h.) 2 /string ;
 11 : DH.   ( ud -- )  (dh.) type space ;
 12 : H.    ( u -- )  (h.) type space ;
 13 : HB.   ( u -- )  (hb.) type space ;
 14 
 15 

Scr# 7 
  0 \ Strings - SPLIT STRING+C C/STRING STRING/
  1 \ Split string at character leaving first on top
  2 : SPLIT  ( a u char -- a2 u2 a3 u3 )
  3   >r 2dup r> scan 2swap 2 pick - ;
  4 
  5 \ Append character to end of string
  6 : STRING+C  ( a u char -- a2 u2 )  >r 2dup + r> swap c! 1+ ;
  7 
  8 \ Extract character from start of string
  9 : C/STRING  ( a u -- a2 u2 char )  over >r 1 /string r> c@ ;
 10 
 11 \ Return n right-most characters of string
 12 : STRING/  ( a u n -- a2 u2 )  over min over swap - /string ;
 13 
 14 
 15 

Scr# 8 
  0 \ Strings - S= S+ STRING S!
  1 \ Compare two strings for equality
  2 : S=  ( a1 u1 a2 u2 -- flag )  compare 0= ;
  3 
  4 255 ( buffer size ) local %1  dup , allot
  5 
  6 \ Concatenate two strings placing result in temp buffer
  7 : S+  ( a1 u1 a2 u2 -- a3 u3 )  2>r  %1 @ min  %1 cell+ 0
  8   2swap string+  %1 @  over -  2r> rot min  string+ ;
  9 
 10 \ Define string variable with max length u
 11 -? : STRING  create ( u -- ) 255 min dup c, 0 c, allot
 12   does> ( -- a u ) 1+ count ;
 13 
 14 \ Store string a u to string variable
 15 : S!  ( a u sa su -- )  drop  1- dup >r  1- c@ min  r> place ;

Page 4     KIMTAPE.SCR

Scr# 9 
  0 \ Cmdline parsing - ARGC ARGV
  1 create ARGC  ( -- a )
  2   1 cells allot ( item# )  2 cells allot ( string )
  3   argc 3 cells erase
  4 
  5 \ Parse next string  ARGC OFF resets
  6 : ARGV  ( -- a u -1 | 0 )
  7   1 argc +!
  8   argc cell+ 2@  0 0
  9   argc @  0 ?do
 10     2drop  bl skip  bl split
 11   loop  2swap 2drop
 12   dup if  -1  else  and  then ;
 13 
 14 
 15 

Scr# 10 
  0 \ Cmdline parsing - BADOPTION /NUM /HEXNUM /NUMRANGE
  1 : BADOPTION  ( -- )  cr ." Invalid option"  error2 ;
  2 
  3 \ Parse number n from string
  4 : /NUM  ( a u -- 0 0 n )  number?
  5   if  drop  else  badoption  then  0 0 ( stop parsing) rot ;
  6 
  7 \ Parse hex number n from string
  8 : /HEXNUM  ( a u -- 0 0 n )  base @ >r  hex /num  r> base ! ;
  9 
 10 \ As for /NUM but checks n3 is in the range n1 to n2
 11 : /NUMRANGE  ( a u n1 n2 -- 0 0 n3 )
 12   2>r /num  dup  2r> 1+  within  0= if badoption then ;
 13 
 14 
 15 

Scr# 11 
  0 \ Cmdline parsing - SETOPTION
  1 \ Process each character in a switch option string
  2 defer SETOPTION  ( a u char -- a u )  ' drop is setoption
  3 
  4 exit
  5 
  6 \ Example of use
  7 : (SETOPTION)  ( a u char -- a u )
  8   upcase [char] A = if  A-variable on  else  badoption  then ;
  9 
 10 ' (setoption) is setoption
 11 
