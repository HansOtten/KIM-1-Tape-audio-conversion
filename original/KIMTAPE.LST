Page 5     KIMTAPE.SCR

Scr# 12 
  0 \ Cmdline parsing - PARSEOPTION
  1 \ Parse multiple switch options from the command-line
  2 : PARSEOPTION  ( -- )
  3   begin
  4     argv
  5   while  ( not end )
  6     c/string
  7     dup [char] / =  swap [char] - =  or if ( switch )
  8       begin  dup
  9       while  c/string setoption
 10       repeat  2drop
 11     else
 12       2drop  -1 argc +! ( backup )  exit
 13     then
 14   repeat ;
 15 

Scr# 13 
  0 \ Cmdline parsing - PARSEFILENAME
  1 \ Parse one or more strings/filenames from the command-line
  2 defer PARSEFILENAME  ( -- )  ' noop is parsefilename
  3 
  4 exit
  5 
  6 \ Example of use
  7 : (PARSEFILENAME)  ( -- )
  8   argv 0= if ." no filename specified"  error1  then
  9   64 min infile place ;
 10 
 11 ' (parsefilename) is parsefilename
 12 
 13 
 14 
 15 

Scr# 14 
  0 \ Cmdline parsing - CMD! CMD@ PARSECMD
  1 \ Set command string for parsing
  2 : CMD!  ( a u -- )  argc cell+ 2!  argc off ;
  3 
  4 \ Get command-line string
  5 : CMD@  ( -- a u )  128 count ;
  6 
  7 \ Parse command-line setting options/filenames
  8 : PARSECMD  ( -- )
  9   cmd@ cmd!  parseoption  parsefilename ;
