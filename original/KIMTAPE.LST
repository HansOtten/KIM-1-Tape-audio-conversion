Scr# 75 
  0 \ SETMODE
  1 \ Select KIM or SYM mode
  2 : SETMODE  ( -- )
  3   sym? if
  4     ['] 0bit-sqr-sym is 0bit-sqr  ['] 1bit-sqr-sym is 1bit-sqr
  5     ['] 0bit-sin-sym is 0bit-sin  ['] 1bit-sin-sym is 1bit-sin
  6     ['] 0bit-sym is 0bit          ['] 1bit-sym is 1bit
  7     ['] gettone-sym is gettone    ['] getbit-sym is getbit
  8   else
  9     ['] 0bit-sqr-kim is 0bit-sqr  ['] 1bit-sqr-kim is 1bit-sqr
 10     ['] 0bit-sin-kim is 0bit-sin  ['] 1bit-sin-kim is 1bit-sin
 11     ['] 0bit-kim is 0bit          ['] 1bit-kim is 1bit
 12     ['] gettone-kim is gettone    ['] getbit-kim is getbit
 13   then ;
