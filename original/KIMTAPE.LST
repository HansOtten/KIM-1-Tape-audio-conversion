  4     sine @ if  0bit-sin  else  0bit-sqr  then  sendbit
  5     flip-polarity
  6   loop ;
  7 
  8 \ Send low tone
  9 : LOWTONE  ( -- )
 10   6  speed @  /  0 do
 11     sine @ if  1bit-sin  else  1bit-sqr  then  sendbit
 12   loop ;
