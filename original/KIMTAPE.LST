  0 \ !ASCBYTE !ASCWORD
  1 \ Write ascii hex byte to file, bump checksum
  2 : !ASCBYTE  ( u -- )
  3   +checksum
  4   16 /mod  ( split into nibbles )
  5   2 0 do
  6     dup 9 >  if 7 + then
  7     [char] 0 +  sendbyte
  8   loop ;
  9 
 10 \ Write ascii hex word (lo-hi) to file
 11 : !ASCWORD  ( u -- )
 12   0  256 um/mod  swap !ascbyte  !ascbyte ;
 13 
