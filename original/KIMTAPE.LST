Scr# 15 
  0 \ File primitives - ?FERROR
  1 \ Display msg and abort on file error
  2 : ?FERROR  ( ior n -- )
  3   swap if
  4     cr ." File "  case
  5       3  of  ." read"  endof
  6       4  of  ." write"  endof
  7       5  of  ." position"  endof
  8       6  of  ." size"  endof
  9     endcase
 10     ."  error"  error2
 11   else  drop  then ;
 12 
 13 
 14 
 15 

Scr# 16 
  0 \ File primitives - READF WRITEF READL WRITEL
  1 \ Read binary
  2 : READF  ( a u handle -- a u2 )
  3   ?break  >r over swap r>  read-file  3 ?ferror ;
  4 
  5 \ Write binary
  6 : WRITEF  ( a u handle -- )
  7   ?break  write-file  4 ?ferror ;
  8 
  9 \ Read text  flag=0 if end-of-file
 10 : READL  ( a u handle -- a u2 flag )
 11   ?break  >r over swap r>  read-line  3 ?ferror ;
 12 
 13 \ Write text
 14 : WRITEL  ( a u handle -- )
 15   ?break  write-line  4 ?ferror ;

Scr# 17 
  0 \ File primitives - FPOS REPOSF FSIZE RESIZEF
  1 \ File position
  2 : FPOS  ( handle  -- ud )  file-position  5 ?ferror ;
  3 
  4 \ Reposition file
  5 : REPOSF  ( ud handle  -- )  reposition-file  5 ?ferror ;
  6 
  7 \ File size
  8 : FSIZE  ( handle  -- ud )  file-size  6 ?ferror ;
  9 
 10 \ Resize file
 11 : RESIZEF  ( ud handle  -- )  resize-file  6 ?ferror ;
 12 
