Scr# 65 
  0 \ GETBIT ?EMIT DECODEBYTE -DECODEBYTE
  1 \ Get next bit
  2 defer  GETBIT  ( -- bit )
  3 
  4 \ Write char to console
  5 : ?EMIT ( char -- )  conout @ if  emit  else  drop  then ;
  6 
  7 \ Decode next byte
  8 : DECODEBYTE  ( -- byt )
  9   sym? if  seekhalf drop  then  ( discard start bit )
 10   0  databits 0 do  1 rshift  getbit  7 lshift  or  loop
 11   dup ?emit ;
 12 
 13 \ Decode next byte ignoring EOF
 14 : -DECODEBYTE  ( -- byt )
 15   ['] decodebyte 1 ?catch if  256 ( dummy )  then ;

Page 23    KIMTAPE.SCR

Scr# 66 
  0 \ SYNCHRONIZE FINDSYNC
  1 \ Scan bitstream for sync character
  2 : SYNCHRONIZE  ( -- )
  3   0 begin
  4     1 rshift  getbit  7 lshift  or  dup sync =
  5   until  ?emit ;
  6 
  7 \ Find 10 consecutive sync characters
  8 : FINDSYNC ( -- )
  9   synchronize
 10   9 begin
 11     decodebyte  sync = if  1-  else  drop
 12       flip-polarity  ( try changing polarity )
 13       synchronize  9  then
 14     ?dup 0=
 15   until ;

Scr# 67 
  0 \ FINDPREAMBLE
  1 \ Find preamble
  2 : FINDPREAMBLE  ( -- )
  3   begin
  4     findsync
  5     begin
  6       decodebyte
  7       dup sync <>  and ?dup  ( skip sync char )
  8     until
  9     [char] * =  ( scan start char )
 10   until ;
