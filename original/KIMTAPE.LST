Scr# 72 
  0 \ GETDATABYTE
  1 \ Get data byte
  2 : GETDATABYTE  ( -- byte flag )
  3   sym? if
  4     decodecount 2@ drop  saddr @ +  eaddr @ = if
  5       decodebyte  dup [char] /  <> if  s" /" missing  then
  6       false  exit  then
  7     decodebyte
  8   else
  9     decodebyte
 10     dup [char] /  = if  false  exit  then
 11     0 swap hexchar  decodebyte hexchar  ( form byte )
 12   then
 13   true ;
 14 
 15 

Scr# 73 
  0 \ GETDATA SKIPHEADER
  1 \ Get program data
  2 : GETDATA  ( -- )
  3   0. decodecount 2!
  4   begin
  5     getdatabyte
  6   while ( not end )
  7     +checksum
  8     conout @ if  drop  else  writechar  then
  9     1 decodecount m+!
 10   repeat drop ;
 11 
 12 \ Skip WAV/VOC header
 13 : SKIPHEADER  ( -- )
 14   64 0 do  readchar if  drop  else  leave  then  loop ;
 15 

Scr# 74 
  0 \ DECODE
  1 \ Convert wave file to program
  2 : DECODE  ( -- )
  3   skipheader
  4   begin
  5     ['] findpreamble  1 ?catch 0=
  6   while  ( program found )
  7     0. decodecount 2!
  8     ['] getid        1 ?catch if s" ID" missing then
  9     0 checksum !
 10     ['] getaddress   1 ?catch if s" address" missing then
 11     ['] getdata      1 ?catch if s" data" missing then
 12     ['] getchecksum  1 ?catch if s" checksum" missing then
 13     getend  .decoded
 14   repeat ;
 15 

