Page 9     KIMTAPE.SCR

Scr# 24 
  0 \ Buffered input file - REFILLREAD READCHAR
  1 here to INBUF  1024 allot  resetinbuf
  2 
  3 \ Refill read buffer
  4 : REFILLREAD  ( -- )
  5   resetinbuf  inbuf 1024 readdata  insiz !  drop ;
  6 
  7 \ Read char from buffered input file
  8 \ : READCHAR  ( -- char -1 | 0 )  insiz @ 0= if refillread then
  9 \  insiz @ if inptr @ c@ 1 inptr +! -1 insiz +! -1 else 0 then ;
 10 
 11 code READCHAR  ( -- char -1 | 0 )  0 # insiz ) cmp
 12   1 l# jnz  c: refillread ;c  1 L:  ax ax sub  ax insiz ) cmp
 13   2 l# jz  inptr ) bx mov  0 [bx] al mov  ax push  inptr ) inc
 14   insiz ) dec  -1 # ax mov  2 L: 1push end-code
 15 

Scr# 25 
  0 \ Buffered output file - FLUSHWRITE WRITECHAR
  1 here to OUTBUF  1024 allot  resetoutbuf
  2 
  3 \ Flush write buffer
  4 :noname  ( -- ior )  outbuf  outsiz @  outfid @  write-file
  5   resetoutbuf ;  is (flushwrite)
  6 
  7 : FLUSHWRITE  ( -- )  (flushwrite)  4 ?ferror ;
  8 
  9 \ Write char to buffered output file
 10 \ : WRITECHAR  ( char -- )  outsiz @ 1024 = if flushwrite then
 11 \  outptr @ c! 1 outptr +! 1 outsiz +! ;
 12 
 13 code WRITECHAR  ( char -- )  1024 # outsiz ) cmp
 14   1 l# jnz  c: flushwrite ;c  1 L:  ax pop  outptr ) bx mov
 15   al 0 [bx] mov  outptr ) inc  outsiz ) inc  next  end-code

