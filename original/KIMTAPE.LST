  0 \ +CHECKSUM !BYTE !WORD
  1 \ Add to checksum
  2 : +CHECKSUM  ( byte -- byte )
  3   255 and  dup checksum +! ;
  4 
  5 \ Write byte to file, bump checksum
  6 : !BYTE  ( u -- )
  7   +checksum  sendbyte ;
  8 
  9 \ Write word (lo-hi) to file
 10 : !WORD  ( u -- )
 11   0  256 um/mod  swap !byte  !byte ;
